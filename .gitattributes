# Line endings are pinned to LF for everything in this repository.
#
# Without this, git on Windows (core.autocrlf=true) rewrites the working copy
# to CRLF on checkout. A reviewer who clones on Windows and then runs the
# scripts under WSL, Git Bash, or a Linux VM gets
#   /usr/bin/env: 'bash\r': No such file or directory
# and nothing runs. eol=lf overrides autocrlf per file, on every platform, so
# install.sh and the six run.sh scripts stay executable wherever they land.

* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.json text eol=lf

# Keep the reference outputs byte-identical; they are compared against.
artifact/reference_outputs/*.json -text
